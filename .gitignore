# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependências ──────────────────────────────────────────────────
node_modules
.pnp
.pnp.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Testing ───────────────────────────────────────────────────────
/coverage

# ── Build de Next.js ──────────────────────────────────────────────
.next/
out/
build/

# ── Ficheiros de Ambiente e Segurança (MUITO IMPORTANTE) ──────────
# Nunca commitar chaves (BRAPI_TOKEN, GEMINI_API_KEY, Appwrite, etc.)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
.env*
!.env.example
*.pem

# ── Logs ──────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
*.log

# ── Vercel / Deploy ───────────────────────────────────────────────
.vercel

# ── Editor e Sistema Operacional ──────────────────────────────────
.DS_Store
*.swp
.vscode/
.idea/

# ── Ficheiros de Cache ────────────────────────────────────────────
.eslintcache
.stylelintcache
*.tsbuildinfo
tsbuildinfo.json
next-env.d.ts
